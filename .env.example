# Copy to .env and supply your own OAuth credentials for Google sign-in.
ENV_PROTUBE_GOOGLE_CLIENT_ID=replace-with-google-client-id
ENV_PROTUBE_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional login success destination (defaults: dev http://localhost:5173/, prod /).
ENV_PROTUBE_FRONTEND_URL="http://localhost:5173/"

# Media storage is independent of the dev/prod database profile.
ENV_PROTUBE_MEDIA_MODE=local
ENV_PROTUBE_LOCAL_MEDIA_DIR=./media-store
# Optional: origin without /media (port 8080 in dev, 8090 in prod).
# ENV_PROTUBE_LOCAL_MEDIA_URL=http://localhost:8080

# OCI service origin, used in both dev and prod when mode=oci.
ENV_PROTUBE_MEDIA_BASE_URL=https://marramiau-protube.duckdns.org
# Backend-only secret, never send to React. Not needed for LOCAL.
ENV_PROTUBE_MEDIA_API_KEY=

# Source folder for the optional videoGrabber tool (not used by Spring).
ENV_PROTUBE_STORE_DIR="C:\path\to\videos"

# Used by the existing PostgreSQL service in compose.yaml.
ENV_PROTUBE_DB_USER=protube
ENV_PROTUBE_DB_PASS=replace-with-a-local-password
ENV_PROTUBE_DB=protube
ENV_PROTUBE_DB_HOST=db
